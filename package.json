{
  "name": "sprinter",
  "version": "0.1.0",
  "private": true,
  "description": "A Notion-style kanban over your Azure DevOps sprint, with a Claude Code terminal per ticket.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "app": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "build:server": "node scripts/build-server.mjs",
    "dist": "npm run build && npm run build:server && electron-builder --win",
    "release": "npm run build && npm run build:server && electron-builder --win --publish always"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.7",
    "dompurify": "^3.4.17",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.22.2"
  },
  "build": {
    "appId": "app.sprinter.desktop",
    "productName": "Sprinter",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "build/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "DarrenJPotts",
      "repo": "Sprinter---Task-Board",
      "releaseType": "release"
    }
  }
}
